{
  "id": "dns-prevleakgroup-com",
  "type": "dns-domain",
  "domain": "prevleakgroup.com",
  "sourcePath": "download-site",
  "publishTarget": "https://prevleakgroup.com/",
  "forwardingExpected": "https://prevleakgroup.co.za/",
  "dnsPolicy": {
    "apexTxtRequired": [
      "T9229417",
      "v=spf1 include:secureserver.net -all"
    ],
    "dmarcRequired": "v=DMARC1; p=reject; rua=mailto:dmarc_rua@onsecureserver.net; adkim=r; aspf=r;"
  },
  "privacyControls": {
    "containsPublicOnlyContent": true,
    "separateOperationalData": true,
    "noRawArtifactLinks": true
  }
}
