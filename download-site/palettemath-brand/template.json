{
  "brand": "palettemath",
  "template": {
    "name": "Palettemath Brand Template",
    "description": "Automated Palettemath brand website template for GoDaddy deployment",
    "version": "1.0.0",
    "colors": {
      "primary": "#0c4c95",
      "primary_light": "#e8f1ff",
      "primary_lighter": "#eaf4ff",
      "primary_pale": "#d4e8ff",
      "secondary": "#475569",
      "background": "#ffffff"
    },
    "typography": {
      "font_family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "heading_size": "2.5rem",
      "heading_weight": 700,
      "body_size": "1.1rem",
      "body_weight": 400
    },
    "assets": {
      "logo": "assets/palettemath-logo.svg",
      "favicon": "assets/palettemath-logo.svg",
      "mask_icon": "assets/palettemath-logo.svg"
    },
    "meta": {
      "title": "Palettemath",
      "description": "Color learning and education platform.",
      "theme_color": "#0c4c95",
      "apple_mobile_capable": true
    },
    "dns_records": {
      "cname": [
        {
          "name": "www",
          "value": "palettemath.co.za"
        },
        {
          "name": "api",
          "value": "palettemath.co.za"
        }
      ],
      "forwarding": [
        {
          "domain": "palettemath.co.za",
          "target": "saferide-peld8.web.app/palettemath-brand",
          "type": "301_permanent"
        },
        {
          "domain": "palettemath.net",
          "target": "saferide-peld8.web.app/palettemath-brand",
          "type": "301_permanent"
        }
      ]
    },
    "firebase": {
      "project": "saferide-peld8",
      "hosting_url": "https://saferide-peld8.web.app/palettemath-brand",
      "routes": [
        "/palettemath-brand/index.html"
      ]
    },
    "automation": {
      "deploy_trigger": "git push origin main",
      "deployment_env": "production",
      "build_command": "npm run build",
      "assets_dir": "download-site/assets"
    }
  }
}
