{
  "brand": "saferide",
  "images": {
    "logo": {
      "file": "assets/saferide-logo.svg",
      "type": "image/svg+xml",
      "anchor_tags": [
        "favicon",
        "apple-touch-icon",
        "mask-icon"
      ]
    },
    "hero": {
      "file": "assets/saferide-logo.svg",
      "display": "hero-section",
      "size": "280px"
    }
  },
  "workflow": {
    "brand_name": "Saferide",
    "functions": {
      "load_brand_assets": {
        "description": "Load logo and brand images",
        "triggers": ["page_load"],
        "operations": [
          "fetch_logo_svg",
          "render_favicon",
          "render_apple_touch_icon",
          "render_hero_image"
        ]
      },
      "render_header": {
        "description": "Render branded header with logo and navigation",
        "triggers": ["page_load", "navigation_change"],
        "elements": ["logo", "brand_name", "nav_links"],
        "colors": {
          "primary": "#f28c28",
          "gradient_start": "#fff4e8",
          "gradient_end": "#ffe6d0"
        }
      },
      "render_portals": {
        "description": "Render driver and rider portals",
        "triggers": ["page_load", "user_role_change"],
        "portals": ["driver_portal", "rider_portal", "operations_center"]
      },
      "apply_branding": {
        "description": "Apply Saferide color scheme globally",
        "triggers": ["theme_change"],
        "apply_to": ["headers", "buttons", "borders", "backgrounds"]
      }
    },
    "api_endpoints": {
      "logo_fetch": "/api/assets/saferide-logo",
      "brand_config": "/api/config/saferide",
      "portal_data": "/api/portals/saferide",
      "driver_assignments": "/api/drivers/assignments",
      "rider_requests": "/api/riders/requests"
    }
  },
  "apps": {
    "web": {
      "entry_point": "https://saferide-peld8.web.app/saferide-brand",
      "api_workflow": [
        "load_config_from_api",
        "fetch_logo_asset",
        "render_brand_header",
        "load_color_scheme",
        "initialize_portal_routing",
        "establish_websocket_connection"
      ]
    },
    "driver_app": {
      "entry_point": "app://saferide/driver",
      "api_workflow": [
        "authenticate_driver",
        "load_driver_config",
        "fetch_saferide_logo",
        "apply_driver_theme",
        "load_active_assignments",
        "initialize_real_time_tracking"
      ]
    },
    "rider_app": {
      "entry_point": "app://saferide/rider",
      "api_workflow": [
        "authenticate_rider",
        "load_rider_config",
        "fetch_saferide_logo",
        "apply_rider_theme",
        "load_request_history",
        "initialize_booking_engine"
      ]
    }
  },
  "core_engine": {
    "ml_operations": {
      "route_optimization": {
        "function": "optimize_driver_routes",
        "data_inputs": ["current_location", "pending_assignments", "traffic_data", "historical_patterns"],
        "operations": ["distance_calc", "time_estimate", "cost_predict", "efficiency_score"],
        "output": "optimized_route_sequence"
      },
      "driver_matching": {
        "function": "match_drivers_to_requests",
        "data_maintained": ["driver_locations", "rider_preferences", "availability_status", "performance_history"],
        "ml_model": "request_to_driver_clustering",
        "output": "best_driver_match"
      },
      "surge_pricing_prediction": {
        "function": "predict_demand_surge",
        "data_inputs": ["historical_demand", "event_calendars", "weather_data"],
        "ml_model": "time_series_forecast",
        "output": "surge_alert_threshold"
      }
    },
    "operational_functions": {
      "real_time_tracking": {
        "function": "track_active_rides",
        "updates": "continuous_websocket",
        "data_points": ["driver_location", "eta", "rider_location", "route_progress"]
      },
      "payment_processing": {
        "function": "process_ride_payment",
        "integration": "stripe_api",
        "operations": ["calculate_fare", "apply_discounts", "process_transaction", "issue_receipt"]
      },
      "performance_monitoring": {
        "function": "track_ride_metrics",
        "metrics": ["completion_time", "customer_rating", "driver_efficiency", "system_latency"],
        "threshold_alerts": true
      }
    }
  }
}
