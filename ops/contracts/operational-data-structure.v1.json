{
  "version": "1.0.0",
  "description": "Canonical operational data structure for field, rider, driver, and public reporting functions.",
  "entities": {
    "incident": {
      "required": ["incidentId", "source", "severity", "status", "assetId", "createdAt"],
      "enums": {
        "source": ["smart_manhole", "public_reporting", "rider_app", "driver_app", "manual_ops"],
        "severity": ["low", "medium", "high", "critical"],
        "status": ["open", "triaged", "assigned", "resolved", "closed"]
      }
    },
    "asset": {
      "required": ["assetId", "assetType", "zone", "healthScore", "updatedAt"],
      "enums": {
        "assetType": ["manhole_cover", "drain_line", "vehicle", "support_channel", "mobile_endpoint"]
      }
    },
    "dispatch": {
      "required": ["dispatchId", "incidentId", "teamId", "etaMinutes", "createdAt"],
      "constraints": {
        "etaMinutes": { "min": 0, "max": 1440 }
      }
    },
    "telemetry": {
      "required": ["eventId", "assetId", "eventType", "eventAt", "confidence"],
      "constraints": {
        "confidence": { "min": 0.0, "max": 1.0 }
      }
    }
  },
  "crossEntityRules": [
    "incident.assetId must reference asset.assetId",
    "dispatch.incidentId must reference incident.incidentId",
    "timestamps must be ISO-8601 UTC",
    "all IDs must be globally unique (UUIDv4 recommended)"
  ]
}
