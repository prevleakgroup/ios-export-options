# ============================================================================
# DECRYPTION INSTRUCTIONS
# ============================================================================

# To decrypt secrets locally:
# 1. Ensure gcloud SDK is installed and authenticated
# 2. For each encrypted value, run:
#    gcloud kms decrypt \
#      --project=saferide-peld8 \
#      --location=global \
#      --keyring=brand-secrets \
#      --key=master-key \
#      --ciphertext-file=encrypted_value.bin
#
# 3. Load decrypted values into environment
# 4. NEVER commit decrypted secrets to Git
# 5. Use GitHub Secrets or Firebase Secrets Manager in CI/CD

