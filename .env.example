# UNIFIED SECRETS CONFIGURATION
# Store in Azure Key Vault, AWS Secrets Manager, or HashiCorp Vault

# GitHub Secrets (set in GitHub repo Settings > Secrets)
FIREBASE_TOKEN=               # Firebase CLI authentication token
FIREBASE_PROJECT_ID=prevleak-group
FIREBASE_DATABASE_URL=        # Your Firebase DB URL

# GoDaddy Credentials
GODADDY_API_KEY=              # GoDaddy API key
GODADDY_API_SECRET=           # GoDaddy API secret

# App Store & Google Play
APPLE_DEVELOPER_ID=           # Apple Developer account ID
APPLE_APP_SPECIFIC_PASSWORD=  # App-specific password
GOOGLE_PLAY_API_KEY=          # Google Play API key
GOOGLE_PLAY_SERVICE_ACCOUNT=  # Google Play service account JSON

# Social Media Platform Tokens
INSTAGRAM_TOKEN=              # Instagram Graph API token
INSTAGRAM_BUSINESS_ACCOUNT=   # Instagram Business Account ID
FACEBOOK_TOKEN=               # Facebook Graph API token
LINKEDIN_TOKEN=               # LinkedIn API token
TWITTER_TOKEN=                # Twitter/X API token
TWITTER_BEARER_TOKEN=         # Twitter Bearer token
TIKTOK_TOKEN=                 # TikTok API token

# GenSpark API
GENSPARK_API_KEY=             # GenSpark API key for automation
GENSPARK_PROJECT_ID=          # GenSpark project ID

# Database & Auth
DATABASE_URL=                 # Firestore database URL
AUTH_DOMAIN=                  # Firebase auth domain
STORAGE_BUCKET=               # Firebase storage bucket

# Email & Notifications
SENDGRID_API_KEY=             # SendGrid for email
TWILIO_ACCOUNT_SID=           # Twilio for SMS
TWILIO_AUTH_TOKEN=            # Twilio auth token

# Analytics & Monitoring
GOOGLE_ANALYTICS_ID=          # Google Analytics tracking ID
SENTRY_DSN=                   # Sentry error tracking
DATADOG_API_KEY=              # DataDog monitoring

# Environment
NODE_ENV=production
REACT_NATIVE_ENV=production
